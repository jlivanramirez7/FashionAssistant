{
  "name": "fashion-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/setup-assets.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy": "gcloud run deploy fashion-assistant --source . --region us-central1 --allow-unauthenticated --max-instances 2"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.0",
    "fflate": "^0.8.3",
    "firebase": "^13.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "firebase-tools": "^15.33.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
