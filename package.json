{
  "name": "fashion-assistant",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:server": "node --watch server/index.ts",
    "build": "npm run typecheck && vite build",
    "start": "node server/index.ts",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/setup-assets.mjs",
    "deploy": "gcloud run deploy fashion-assistant --source . --region us-central1 --allow-unauthenticated --max-instances 2"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.3.1",
    "@mediapipe/tasks-vision": "^1.1.0",
    "fflate": "^0.8.3",
    "google-auth-library": "^11.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
